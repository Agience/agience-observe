<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0 is the LTS the node architecture names. The SDK on this box is 9.x, which targets
         8.0 fine; the 8.0 WindowsDesktop runtime is present. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Agience.Manager</RootNamespace>
    <!-- â›” THE PRODUCT IS CALLED "Agience" â€” NOT "Agience Manager" [John, 2026-09-02]. This is
         the name a PERSON sees: it is the exe in Task Manager, the folder under Program Files, and
         the label in Settings > Taskbar > Other system tray icons, which reads FileDescription.
         The C# namespace stays `Agience.Manager` because a namespace is a code-organisation detail
         nobody outside this repository reads. -->
    <AssemblyName>Agience</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- âš  THE SAME .ico THE INSTALLER USES, and generated by `installer/make-icon.ps1` rather than
         committed as a blob. A shortcut whose icon differs from the exe's is the small wrongness
         that makes an application look unfinished before it has done anything. -->
    <ApplicationIcon>..\..\installer\agience.ico</ApplicationIcon>
    <!-- Set here rather than in the manifest: the WinForms SDK refuses DPI settings in a
         manifest (WFAC010) so that the generated ApplicationConfiguration.Initialize() and
         the manifest cannot disagree about the same setting. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- WinForms has no first-class tray icon in WPF or WinUI; NotifyIcon is still the supported
         path, and it can own a WPF window later without this choice being revisited. -->

    <!-- âš  SELF-CONTAINED IS A PUBLISH FLAG, NOT A PROJECT PROPERTY, AND DELIBERATELY SO. Pinning a
         RuntimeIdentifier here forces every project that references this one â€” the test project
         first â€” to pin the same one, and a RID mismatch fails the restore with a message about
         package graphs rather than about what is actually wrong. The publish command in README.md
         carries them, where they belong.

         Trimming stays OFF wherever it is invoked: WinForms reflects over designer-generated types,
         and a trimmed tray app fails at the first menu, at run time, on someone else's machine. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Warnings are errors here because this assembly is small enough that there is no excuse,
         and a nullability warning in the frame model is exactly the class of bug that renders as a
         confidently wrong icon. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- What Add/Remove Programs, the file properties dialog and a support request all read. The
         MSI carries its own copies of the version and the publisher; these are what the BINARY
         says, and a binary that disagrees with the installer that shipped it is the thing nobody
         can debug over the phone. -->
    <Version>0.1.0</Version>
    <Company>Ikailo Inc.</Company>
    <Product>Agience</Product>
    <AssemblyTitle>Agience</AssemblyTitle>
    <Description>Starts, stops and configures Agience services: Origin and Mantle.</Description>
    <Copyright>Copyright (c) Ikailo Inc.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- The configuration, the service table and the supervisor. Shared with the test project,
         which is the whole reason it is a separate assembly: a WinExe cannot be referenced. -->
    <ProjectReference Include="..\Agience.Core\Agience.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- â›” THE BRAND MARK IS EMBEDDED, NOT COPIED BESIDE THE EXE. The published application is a
         single self-contained file, so a mark loaded from disk would be a second file the MSI has
         to carry and a second thing that can go missing â€” and the failure would be a tray icon that
         silently stopped looking like Agience. `Icons.cs` composites it with a status badge. -->
    <EmbeddedResource Include="..\..\installer\agience-logo.png">
      <LogicalName>Agience.Manager.agience-logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

